{
  "id": "/helana_log/",
  "name": "How Helena Lives",
  "short_name": "Helena Lives",
  "description": "The life story of my sister Helena, living with schizophrenia. A record of how she makes it through each day — held within faith, music, and family care.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/helana_log/",
  "scope": "/helana_log/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#0a0908",
  "theme_color": "#0a0908",
  "categories": ["lifestyle", "health", "family"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/helana_log/icons/favicon-32.png",
      "sizes": "32x32",
      "type": "image/png",
      "purpose": "any"
    },
    {
